# ============================================================================
#  통합 서버 환경변수 예시 — 실제 값은 .env 로 복사 후 입력 (git 커밋 금지)
#
#  MCP(코드 기반 처리)와 Agent(LLM 판단)가 한 프로세스에서 돈다. 두 서비스의
#  환경변수는 예전 이름을 그대로 쓴다 — 설정을 옮겨 적을 필요가 없다.
#    CODETEST_MCP_*  → MCP
#    CODETEST_*      → Agent
#    CODETEST_SUM_*  → 둘을 묶는 결합 서버
# ============================================================================

# --- 결합 서버 (CLI 가 붙는 주소) -------------------------------------------
CODETEST_SUM_HOST=0.0.0.0
CODETEST_SUM_PORT=80
# MCP 엔드포인트 경로. CLI 의 CODETEST_SERVER_URL 이 여기를 가리켜야 한다.
#   예: CODETEST_SERVER_URL=http://<host>:80/mcp
CODETEST_SUM_MCP_PATH=/mcp

# --- MCP (코드 기반 처리) ----------------------------------------------------
CODETEST_MCP_APP_NAME="Code Test MCP"
# CLI 가 X-API-Key 헤더로 보내야 하는 값 (쉼표로 복수 허용).
# 비워 두면 인증이 비활성화된다 — 로컬 개발에서만 그렇게 쓸 것.
CODETEST_MCP_API_KEYS=local-dev-key
CODETEST_MCP_DATABASE_URL=sqlite:///./data/codetest_mcp.db
CODETEST_MCP_WORKSPACE_DIR=./workspace
# Agent 주소. **비워 두면 결합 서버가 자기 자신을 가리키게 채운다.**
# Agent 를 따로 떼어 띄울 때만 직접 지정한다.
# CODETEST_MCP_AGENT_BASE_URL=http://127.0.0.1:8000
CODETEST_MCP_AGENT_API_KEY=
# Agent 일반 요청(헬스 등) 대기 시간(초)
CODETEST_MCP_AGENT_TIMEOUT=180
# LLM 호출의 **무응답** 상한(초). 총 소요 시간이 아니다 —
# Agent 가 생성 중에 ping 을 흘려보내므로 살아 있는 한 걸리지 않는다.
CODETEST_MCP_AGENT_STREAM_IDLE=180

# --- Agent (LLM 판단) --------------------------------------------------------
CODETEST_APP_NAME="Code Test AI Agent"
# 결합 서버로 돌리면 이 둘은 쓰이지 않는다 (Agent 를 따로 띄울 때만 의미가 있다)
CODETEST_HOST=0.0.0.0
CODETEST_PORT=8000
# MCP 가 Agent 를 부를 때 붙이는 키. 위 CODETEST_MCP_AGENT_API_KEY 와 짝이다.
CODETEST_API_KEYS=local-dev-key

# --- LLM (OpenAI) ------------------------------------------------------------
# OpenAI 호환 엔드포인트 주소. 비우면 https://api.openai.com/v1
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-proj-...
CODETEST_LLM_MODEL=gpt-5
# 출력 토큰 상한. 생성 시간은 이 값에 가장 크게 좌우된다.
CODETEST_LLM_MAX_TOKENS=32000
# 생성이 끝날 때까지 keep-alive 를 보내는 간격(초).
CODETEST_LLM_PING_SECONDS=10
